---

<section class="fold why-fold" style="background: #F4F4F4; overflow: hidden;">

  <!-- Subtle background texture on the top half -->
  <div class="absolute inset-0 pointer-events-none z-0" style="background: linear-gradient(180deg, rgba(102,166,172,0.06) 0%, transparent 48%)"></div>
  <img
    src="/images/certified-bg.jpg"
    alt=""
    class="absolute inset-0 w-full h-full object-cover opacity-[0.04] pointer-events-none"
    aria-hidden="true"
    loading="lazy"
  />

  <!-- ── Heading area ──────────────────────────────────────── -->
  <div class="absolute z-10 inset-x-0 flex flex-col items-center justify-center gap-6" style="top: 0; height: 38%;">
    <h2
      class="font-heading font-bold text-dark-blue text-center leading-[1.15]"
      style="font-size: clamp(1.875rem, 3.5vw, 2.75rem);"
    >
      Why choose <span class="text-teal">DTIOH?</span>
    </h2>

    <!-- Slide dots -->
    <div class="flex items-center gap-3" role="tablist" aria-label="Why DTIOH slides">
      {groups.map((_, i) => (
        <button
          class="why-dot rounded-full transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal"
          data-why-dot={i}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-label={`Slide ${i + 1}`}
          style={i === 0
            ? 'width: 24px; height: 7px; background: #219169; border: none; padding: 0; cursor: pointer;'
            : 'width: 7px; height: 7px; background: rgba(12,46,60,0.2); border: none; padding: 0; cursor: pointer;'}
        />
      ))}
    </div>
  </div>

  <!-- ── Sliding columns ──────────────────────────────────── -->
  <div
    class="absolute inset-x-0"
    style="bottom: 0; height: 62%; overflow: hidden;"
  >
    <div
      id="why-track"
      class="flex h-full"
      style="width: 200%; transition: transform 0.65s cubic-bezier(0.4, 0, 0.2, 1);"
    >
      {groups.map((group, gi) => (
        <div
          class="flex h-full shrink-0"
          style="width: 50%;"
          aria-hidden={gi !== 0 ? 'true' : undefined}
        >
          {group.map((item) => (
            <div
              class="flex-1 flex flex-col items-center justify-center gap-5 px-8 text-center"
              style={`background: ${item.bg}; color: ${item.text};`}
            >
              <div class="w-12 h-12 shrink-0" set:html={item.icon} />
              <div>
                <h3
                  class="font-heading font-bold leading-snug"
                  style="font-size: clamp(1rem, 1.5vw, 1.25rem);"
                >
                  {item.title}
                </h3>
                <p
                  class="font-body mt-2 leading-relaxed max-w-xs mx-auto"
                  style={`font-size: clamp(0.75rem, 1vw, 0.875rem); opacity: ${item.text === 'white' ? '0.75' : '0.72'};`}
                >
                  {item.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>

</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const track  = document.getElementById('why-track') as HTMLElement;
  const dots   = [...document.querySelectorAll<HTMLElement>('[data-why-dot]')];
  const slides = [...track.querySelectorAll<HTMLElement>(':scope > div')];
  let current  = 0;
  let timer: ReturnType<typeof setInterval> | null = null;

  function goTo(index: number) {
    if (index === current) return;

    // outgoing dot
    dots[current].style.width      = '7px';
    dots[current].style.background = 'rgba(12,46,60,0.2)';
    dots[current].setAttribute('aria-selected', 'false');

    // incoming dot
    current = index;
    dots[current].style.width      = '24px';
    dots[current].style.background = '#219169';
    dots[current].setAttribute('aria-selected', 'true');

    // slide track
    track.style.transform = `translateX(-${current * 50}%)`;

    slides.forEach((s, i) => s.setAttribute('aria-hidden', i !== current ? 'true' : 'false'));
  }

  function restartTimer() {
    if (timer) clearInterval(timer);
    timer = setInterval(() => goTo((current + 1) % slides.length), 4000);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => { goTo(i); restartTimer(); });
  });

  // Pause when not in view, resume when in view
  ScrollTrigger.create({
    trigger: '.why-fold',
    start: 'top 80%',
    end: 'bottom 20%',
    onEnter:     restartTimer,
    onLeave:     () => { if (timer) { clearInterval(timer); timer = null; } },
    onEnterBack: restartTimer,
    onLeaveBack: () => { if (timer) { clearInterval(timer); timer = null; } },
  });

  // Heading entrance
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.from('.why-fold h2, .why-fold [role="tablist"]', {
      scrollTrigger: { trigger: '.why-fold', start: 'top 65%' },
      y: 24, opacity: 0, stagger: 0.12, duration: 0.7, ease: 'power3.out',
    });
  }
</script>
