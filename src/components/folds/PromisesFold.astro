---
---

<section
  class="fold"
  style="background: linear-gradient(150deg, #c8efaa 0%, #dff5cd 30%, #eef8ec 55%, #f4f4f4 85%)"
>
  <!-- Background blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
    <div
      class="absolute -bottom-24 left-[28%] w-[560px] h-[560px] rounded-full blur-3xl"
      style="background: #C0F18028"
    ></div>
    <div
      class="absolute top-0 right-0 w-[320px] h-[320px] rounded-full blur-2xl bg-white/70"
    ></div>
  </div>

  <!-- Decorative concentric circles (desktop only) -->
  <div
    class="absolute hidden lg:block right-[12%] top-1/2 -translate-y-1/2 z-0 pointer-events-none"
  >
    <div
      class="w-[460px] h-[460px] rounded-full border border-teal/20"
    ></div>
    <div
      class="absolute inset-[80px] rounded-full border border-teal/15"
    ></div>
  </div>

  <!-- Main content -->
  <div
    class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-16 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
  >
    <!-- Left: copy -->
    <div>
      <h2
        class="font-heading font-bold text-3xl leading-tight lg:text-[2.75rem] lg:leading-[1.15] text-dark-blue"
      >
        What we do and<br />our <span class="text-teal">promises</span>
      </h2>
      <p
        class="font-body text-dark-blue/65 text-sm lg:text-base mt-5 leading-relaxed max-w-sm"
      >
        At Dr. Tasneem's Institute of Health, we lead the way in professional
        healthcare and aesthetic education in Pakistan. Since 2020, our focus
        has been on shaping the next generation of certified professionals
        through a balanced approach—combining clinical excellence, hands-on
        training, and holistic wellness.
      </p>
      <p
        class="font-body font-semibold text-teal text-sm mt-5 leading-relaxed max-w-sm"
      >
        Our mission is to deliver world-class education that empowers careers
        and elevates the standards of the beauty and wellness industry.
      </p>
    </div>

    <!-- Right: staggered promises with vertical divider -->
    <div class="relative h-[420px] lg:h-[480px]">
      <!-- Vertical divider line with dots -->
      <div
        class="absolute left-1/2 -translate-x-1/2 top-4 bottom-4 flex flex-col items-center z-10"
      >
        <div class="w-2.5 h-2.5 rounded-full bg-gray-400/50"></div>
        <div class="flex-1 w-px bg-gray-400/35 my-1.5"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-gray-400/50"></div>
      </div>

      <!-- Left column — right-aligned, text-right -->
      <div class="absolute inset-y-0 left-0 right-1/2">
        <p
          class="font-heading font-bold text-lg lg:text-2xl text-dark-blue/25 leading-tight absolute top-[20%] right-6 text-right"
        >
          Professional<br />Training
        </p>
        <p
          class="font-heading font-bold text-lg lg:text-2xl text-dark-blue/25 leading-tight absolute top-[50%] right-6 text-right"
        >
          Institute<br />Excellence
        </p>
        <p
          class="font-heading font-bold text-lg lg:text-2xl text-dark-blue/25 leading-tight absolute top-[73%] right-6 text-right"
        >
          Recognized<br />Certification
        </p>
      </div>

      <!-- Right column — left-aligned, "Excellence & Expertise" is the active item -->
      <div class="absolute inset-y-0 left-1/2 right-0">
        <p
          class="font-heading font-bold text-lg lg:text-2xl text-dark-blue/25 leading-tight absolute top-[10%] left-6"
        >
          Accredited<br />Programs
        </p>
        <p
          class="font-heading font-bold text-xl lg:text-[1.75rem] text-dark-blue leading-tight absolute top-[38%] left-6"
        >
          Excellence<br />&amp; Expertise
        </p>
        <p
          class="font-heading font-bold text-lg lg:text-2xl text-dark-blue/25 leading-tight absolute top-[66%] left-6"
        >
          Certified<br />Careers
        </p>
      </div>
    </div>
  </div>
</section>
