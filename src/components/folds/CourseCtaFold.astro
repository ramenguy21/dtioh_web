---
---

<section class="fold">
  <!-- Background image + dark-blue gradient overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/course-cta-bg.webp"
      alt=""
      class="w-full h-full object-cover object-center"
      loading="lazy"
    />
    <div
      class="absolute inset-0"
      style="background: linear-gradient(100deg, #0C2E3C 30%, #0C2E3Ccc 55%, #0C2E3C66 100%)"
    ></div>
  </div>

  <!-- Content — lower-right -->
  <div class="absolute z-10 inset-x-0" style="bottom: 16%;">
    <div class="max-w-7xl mx-auto px-6 lg:px-16">
      <div class="flex justify-start lg:justify-end">
        <div class="max-w-2xl text-left lg:text-right">
          <h2
            class="font-heading font-bold text-white leading-[1.25]"
            style="font-size: clamp(1.5rem, 2.8vw, 2.375rem)"
          >
            With advanced facilities and
            <span class="text-lime">expert instructors</span>, we provide
            hands-on training that prepares you for
            <span class="text-lime">real-world success.</span>
          </h2>
          <p class="font-body text-white/65 text-sm lg:text-base mt-4 max-w-lg lg:ml-auto leading-relaxed">
            Our graduates leave equipped with the skills, confidence, and
            credentials to thrive in Pakistan's growing aesthetic healthcare
            industry.
          </p>
          <a
            href="/courses"
            class="mt-7 inline-flex items-center gap-2.5 bg-lime text-dark-blue font-button font-semibold text-sm px-7 py-4 rounded-full transition-all duration-200 hover:scale-105 hover:bg-white group"
          >
            Explore Courses
            <svg
              class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 13L13 3" />
              <path d="M6 3H13V10" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
