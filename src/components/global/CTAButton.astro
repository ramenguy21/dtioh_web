---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  size?: 'default' | 'sm';
}

const { href, variant = 'primary', size = 'default' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2.5 font-button font-semibold rounded-full transition-all duration-200 group',
    size === 'default' ? 'px-8 py-4 text-base' : 'px-5 py-2.5 text-sm',
    variant === 'primary'
      ? 'bg-teal text-white hover:bg-cta-hover hover:scale-105'
      : 'border-2 border-dark-blue text-dark-blue hover:bg-dark-blue hover:text-white hover:scale-105',
  ]}
>
  <slot />
  <svg
    class="w-4 h-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M3 13L13 3" />
    <path d="M6 3H13V10" />
  </svg>
</a>
