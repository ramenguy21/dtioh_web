---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['flex items-center gap-3 font-button text-sm', className]}>
  <span>Scroll down</span>
  <div class="w-9 h-9 rounded-full border-2 border-current/50 flex items-center justify-center">
    <svg
      class="w-4 h-4 animate-bounce"
      viewBox="0 0 16 16"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M8 3v10M4 9l4 4 4-4" />
    </svg>
  </div>
</div>
