---
const quickLinks = [
  { label: "About Us", href: "/about" },
  { label: "Clinic", href: "/clinic" },
  { label: "Courses", href: "/courses" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];

const services = [
  "HydraFacial",
  "PRP (Face & Hair)",
  "Laser Hair Removal",
  "Microneedling",
  "Botox & Fillers",
  "Cupping Therapy",
  "Mesotherapy",
  "Weight Management",
];

const courses = [
  {
    label: "Non-Invasive Beautician",
    href: "/courses/listing/non-invasive-beautician",
  },
  {
    label: "Health & Wellness Specialist",
    href: "/courses/listing/health-wellness-specialist",
  },
  {
    label: "Health and Nutrition",
    href: "/courses/listing/health-and-nutrition",
  },
  { label: "Cupping Therapy", href: "/courses/listing/cupping-therapy" },
];

const socials = [
  {
    label: "Facebook",
    href: "https://facebook.com/dtioh",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>`,
  },
  {
    label: "Instagram",
    href: "https://instagram.com/dtioh",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>`,
  },
  {
    label: "WhatsApp",
    href: "https://wa.me/923022301918",
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`,
  },
];
---

<!--
  Footer is a scroll-snap section so it's reachable on every page
  without using the .fold class (avoids overflow:hidden clipping the layout).
-->
<footer
  class="footer-section relative"
  style="scroll-snap-align: start; min-height: 52dvh; background: #0C2E3C;"
  aria-label="Site footer"
>
  <!-- Background image -->
  <img
    src="/images/footer.jpg"
    alt=""
    class="absolute inset-0 w-full h-full object-cover object-center opacity-60 pointer-events-none"
    aria-hidden="true"
    loading="lazy"
  />
  <!-- Dark gradient overlay to ensure text legibility -->
  <div
    class="absolute inset-0 pointer-events-none"
    style="background: linear-gradient(180deg, rgba(12,46,60,0.45) 0%, rgba(12,46,60,0.65) 60%, rgba(12,46,60,0.88) 100%)"
  >
  </div>

  <div
    class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-16 pt-16 pb-8 flex flex-col gap-12"
  >
    <!-- ── Main grid ──────────────────────────────────────── -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-10">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1 flex flex-col gap-5">
        <!-- Logo mark -->
        <a href="/" class="flex items-center gap-3 group w-fit">
          <!-- Botanical icon matching the footer screenshot -->
          <svg
            class="w-10 h-10 shrink-0"
            viewBox="0 0 40 40"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <!-- Stacked line bars -->
            <rect x="4" y="28" width="14" height="2.5" rx="1.25" fill="#C0F180"
            ></rect>
            <rect
              x="4"
              y="23"
              width="18"
              height="2.5"
              rx="1.25"
              fill="#C0F180"
              opacity="0.75"></rect>
            <rect
              x="4"
              y="18"
              width="12"
              height="2.5"
              rx="1.25"
              fill="#C0F180"
              opacity="0.5"></rect>
            <!-- Leaf / stem -->
            <path
              d="M20 27 C20 20 26 14 32 10 C28 10 22 13 20 20 C18 13 12 10 8 10 C14 14 20 20 20 27Z"
              fill="#C0F180"></path>
            <line
              x1="20"
              y1="10"
              x2="20"
              y2="27"
              stroke="#C0F180"
              stroke-width="1.2"
              stroke-linecap="round"></line>
          </svg>
          <div>
            <p
              class="font-button font-bold text-white uppercase leading-snug"
              style="font-size: 0.6rem; letter-spacing: 0.07em; max-width: 100px;"
            >
              Dr. Tasneem's<br />Institute of<br />Health
            </p>
          </div>
        </a>

        <p
          class="font-body text-white/50 text-xs leading-relaxed max-w-[200px]"
        >
          Pakistan's leading aesthetic and healthcare education institute. DUHS
          affiliated · SBTE recognized.
        </p>

        <!-- Social icons -->
        <div class="flex items-center gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.label}
                class="w-8 h-8 rounded-full flex items-center justify-center text-white/60 hover:text-white hover:bg-white/12 transition-all duration-200"
                style="border: 1px solid rgba(255,255,255,0.15);"
              >
                <span class="w-3.5 h-3.5" set:html={s.icon} />
              </a>
            ))
          }
        </div>

        <!-- Accreditation pills -->
        <div class="flex flex-wrap gap-2">
          <span
            class="px-2.5 py-1 rounded-full border border-lime/30 text-lime text-[0.6rem] font-button font-medium leading-none"
            >DUHS Affiliated</span
          >
          <span
            class="px-2.5 py-1 rounded-full border border-white/15 text-white/50 text-[0.6rem] font-button font-medium leading-none"
            >SBTE Recognized</span
          >
        </div>
      </div>

      <!-- Quick Links -->
      <div class="flex flex-col gap-4">
        <p
          class="font-button font-semibold text-white text-xs uppercase tracking-widest"
        >
          Quick Links
        </p>
        <ul class="flex flex-col gap-2.5">
          {
            quickLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="font-body text-white/55 text-sm hover:text-lime transition-colors duration-200 flex items-center gap-2 group"
                >
                  <svg
                    class="w-2.5 h-2.5 text-white/20 group-hover:text-lime transition-colors duration-200 shrink-0"
                    viewBox="0 0 10 10"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M2 5h6M5 2l3 3-3 3" />
                  </svg>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Services -->
      <div class="flex flex-col gap-4">
        <p
          class="font-button font-semibold text-white text-xs uppercase tracking-widest"
        >
          Clinic Services
        </p>
        <ul class="flex flex-col gap-2.5">
          {
            services.map((s) => (
              <li>
                <a
                  href="/clinic"
                  class="font-body text-white/55 text-sm hover:text-lime transition-colors duration-200 flex items-center gap-2 group"
                >
                  <svg
                    class="w-2.5 h-2.5 text-white/20 group-hover:text-lime transition-colors duration-200 shrink-0"
                    viewBox="0 0 10 10"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M2 5h6M5 2l3 3-3 3" />
                  </svg>
                  {s}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Courses + Contact -->
      <div class="flex flex-col gap-8">
        <div class="flex flex-col gap-4">
          <p
            class="font-button font-semibold text-white text-xs uppercase tracking-widest"
          >
            Courses
          </p>
          <ul class="flex flex-col gap-2.5">
            {
              courses.map((c) => (
                <li>
                  <a
                    href={c.href}
                    class="font-body text-white/55 text-sm hover:text-lime transition-colors duration-200 flex items-center gap-2 group"
                  >
                    <svg
                      class="w-2.5 h-2.5 text-white/20 group-hover:text-lime transition-colors duration-200 shrink-0"
                      viewBox="0 0 10 10"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M2 5h6M5 2l3 3-3 3" />
                    </svg>
                    {c.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex flex-col gap-3">
          <p
            class="font-button font-semibold text-white text-xs uppercase tracking-widest"
          >
            Contact
          </p>
          <a
            href="tel:+923022301918"
            class="font-body text-white/55 text-sm hover:text-lime transition-colors duration-200"
            >+92 302 2301918</a
          >
          <a
            href="mailto:hello@dtioh.com"
            class="font-body text-white/55 text-sm hover:text-lime transition-colors duration-200"
            >hello@dtioh.com</a
          >
          <p class="font-body text-white/40 text-xs leading-relaxed">
            Malir Cantt & Clifton,<br />Karachi, Pakistan
          </p>
        </div>
      </div>
    </div>

    <!-- ── Divider ─────────────────────────────────────────── -->
    <div style="height: 1px; background: rgba(255,255,255,0.08);"></div>

    <!-- ── Bottom bar ─────────────────────────────────────── -->
    <div
      class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"
    >
      <p class="font-body text-white/35 text-xs">
        © 2026 Dr. Tasneem's Institute of Health. All rights reserved.
      </p>
    </div>
  </div>
</footer>
