---
import Base from '../layouts/Base.astro';
import ScrollIndicator from '../components/global/ScrollIndicator.astro';

const stats = [
  { value: '20+', label: 'Years of Excellence' },
  { value: '1000+', label: 'Patients Treated' },
  { value: '500+', label: 'Graduates' },
  { value: '4', label: 'Accredited Programs' },
];

const values = [
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    title: 'Medical Excellence',
    desc: 'Evidence-based treatments delivered at the highest clinical standard.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Patient Safety',
    desc: 'Rigorous protocols and sterilization at every step of care.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/></svg>`,
    title: 'Holistic Wellness',
    desc: 'Combining medical science with artistic vision for whole-person care.',
  },
  {
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
    title: 'Professional Integrity',
    desc: 'Transparent, ethical practice you can trust — every single time.',
  },
];

const reasons = [
  {
    title: 'Expert Team',
    desc: 'Led by Dr. Tasneem, our practitioners bring years of clinical expertise and a passion for aesthetic healthcare.',
  },
  {
    title: 'Advanced Technology',
    desc: 'State-of-the-art equipment and cutting-edge techniques deliver consistently superior results.',
  },
  {
    title: 'Accredited Programs',
    desc: 'SBTE-certified and DUHS-affiliated certifications respected across Pakistan and internationally.',
  },
  {
    title: 'Patient-Centric Care',
    desc: 'Every treatment plan is tailored to the individual — your goals, your timeline, your comfort.',
  },
  {
    title: 'Holistic Approach',
    desc: 'We address aesthetics, nutrition, and wellness together for outcomes that last.',
  },
  {
    title: 'Proven Track Record',
    desc: 'Over 20 years, thousands of patients and hundreds of trained professionals speak for themselves.',
  },
];
---

<Base
  title="About Us | Dr. Tasneem's Institute of Health — Aesthetic & Healthcare Education"
  description="Founded in 2002, Dr. Tasneem's Institute of Health is Pakistan's leading DUHS & SBTE accredited aesthetic and healthcare training institute. 20+ years, 1000+ patients, 500+ graduates."
>
  <main>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- FOLD 1 — HERO                                          -->
    <!-- ══════════════════════════════════════════════════════ -->
    <section class="fold about-hero" data-hero>
      <div class="absolute inset-0 z-0">
        <img src="/images/journey-bg.webp" alt="" class="w-full h-full object-cover object-center" loading="eager" />
        <div class="absolute inset-0" style="background: linear-gradient(135deg, #0C2E3C 0%, rgba(12,46,60,0.75) 100%)"></div>
      </div>

      <div class="absolute bottom-16 lg:bottom-20 left-0 right-0 z-10">
        <div class="max-w-7xl mx-auto px-6 lg:px-16">
          <p class="font-button font-medium text-lime text-sm tracking-widest uppercase mb-4">Est. 2002</p>
          <h1
            class="font-heading font-bold text-white leading-[1.1] max-w-2xl"
            style="font-size: clamp(2rem, 4.5vw, 3.5rem);"
          >
            Building Excellence in<br />
            <span class="text-lime">Aesthetic Healthcare</span>
          </h1>
          <p class="font-body text-white/65 text-sm lg:text-base mt-5 max-w-md leading-relaxed">
            Revolutionizing aesthetic healthcare and professional education in Pakistan through evidence-based treatments, hands-on training, and a commitment to holistic wellness.
          </p>

          <!-- Stats row -->
          <div class="flex flex-wrap gap-x-10 gap-y-4 mt-10">
            {stats.map((s) => (
              <div>
                <p class="font-heading font-bold text-lime" style="font-size: clamp(1.75rem, 3vw, 2.5rem); line-height: 1;">{s.value}</p>
                <p class="font-body text-white/55 text-xs mt-1">{s.label}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

      <ScrollIndicator class="absolute bottom-8 right-8 lg:right-16 z-10 text-white/80" />
    </section>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- FOLD 2 — MISSION + CORE VALUES                         -->
    <!-- ══════════════════════════════════════════════════════ -->
    <section class="fold about-mission" style="background: #F4F4F4;">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-20 -right-20 w-[400px] h-[400px] rounded-full blur-3xl" style="background: rgba(192,241,128,0.18)"></div>
        <div class="absolute bottom-0 left-[5%] w-[300px] h-[300px] rounded-full blur-3xl" style="background: rgba(102,166,172,0.10)"></div>
      </div>

      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-16">
        <div class="grid lg:grid-cols-2 gap-14 lg:gap-20 items-center">

          <!-- Left: Our story -->
          <div>
            <p class="font-button font-medium text-teal text-xs tracking-widest uppercase mb-3">Our Story</p>
            <h2
              class="font-heading font-bold text-dark-blue leading-[1.15]"
              style="font-size: clamp(1.75rem, 3vw, 2.5rem);"
            >
              Two Decades of<br /><span class="text-teal">Impact & Innovation</span>
            </h2>
            <p class="font-body text-dark-blue/60 text-sm lg:text-base mt-5 leading-relaxed">
              Founded in 2002 as a small clinic in Karachi, Dr. Tasneem's Institute of Health has grown into a respected centre for aesthetic medicine and professional healthcare education. Affiliated with Dow University of Health Sciences (DUHS) and recognized by the Sindh Board of Technical Education (SBTE), our qualifications carry weight both in Pakistan and internationally.
            </p>
            <p class="font-body text-dark-blue/60 text-sm lg:text-base mt-4 leading-relaxed">
              Our mission is to revolutionize aesthetic healthcare through evidence-based treatments, rigorous professional education, and a holistic approach to wellness — combining medical science with artistic vision.
            </p>
            <div class="flex gap-6 mt-8">
              <span class="px-4 py-1.5 rounded-full border border-teal/30 text-teal text-xs font-button font-medium">DUHS Affiliated</span>
              <span class="px-4 py-1.5 rounded-full border border-dark-blue/20 text-dark-blue/60 text-xs font-button font-medium">SBTE Recognized</span>
            </div>
          </div>

          <!-- Right: Core Values 2×2 grid -->
          <div class="grid grid-cols-2 gap-4">
            {values.map((v) => (
              <div
                class="rounded-2xl p-5 flex flex-col gap-3 bg-white shadow-[0_4px_20px_rgba(12,46,60,0.07)] hover:shadow-[0_8px_28px_rgba(12,46,60,0.11)] transition-shadow duration-300"
              >
                <div class="w-9 h-9 text-teal" set:html={v.icon} />
                <h3 class="font-heading font-semibold text-dark-blue text-[0.9375rem] leading-snug">{v.title}</h3>
                <p class="font-body text-dark-blue/55 text-xs leading-relaxed">{v.desc}</p>
              </div>
            ))}
          </div>

        </div>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════ -->
    <!-- SECTION 3 — WHY CHOOSE DTIOH                           -->
    <!-- Non-fold: 6-card grid may exceed 100dvh on some screens -->
    <!-- ══════════════════════════════════════════════════════ -->
    <section
      class="about-reasons relative"
      style="scroll-snap-align: start; min-height: 100dvh; background: #0C2E3C;"
    >
      <!-- Subtle texture -->
      <img src="/images/certified-bg.webp" alt="" class="absolute inset-0 w-full h-full object-cover opacity-[0.06] pointer-events-none" aria-hidden="true" loading="lazy" />
      <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(160deg, rgba(33,145,105,0.08) 0%, transparent 60%)"></div>

      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-16 py-24 lg:py-28">
        <div class="text-center mb-12">
          <p class="font-button font-medium text-lime text-xs tracking-widest uppercase mb-3">The DTIOH Difference</p>
          <h2
            class="font-heading font-bold text-white leading-[1.15]"
            style="font-size: clamp(1.875rem, 3.5vw, 2.75rem);"
          >
            Why Choose <span class="text-lime">DTIOH</span>?
          </h2>
          <p class="font-body text-white/55 text-sm lg:text-base mt-3 max-w-lg mx-auto leading-relaxed">
            Over two decades of excellence, innovation, and commitment to our patients and students.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {reasons.map((r, i) => (
            <div
              class="rounded-2xl p-6 flex flex-col gap-3"
              style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.10); backdrop-filter: blur(12px);"
            >
              <div
                class="w-9 h-9 rounded-full flex items-center justify-center shrink-0 font-heading font-bold text-dark-blue text-sm"
                style="background: #C0F180;"
              >
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3 class="font-heading font-semibold text-white text-[1rem] leading-snug">{r.title}</h3>
              <p class="font-body text-white/55 text-[0.8125rem] leading-relaxed">{r.desc}</p>
            </div>
          ))}
        </div>

        <!-- CTA strip -->
        <div class="flex flex-wrap gap-4 justify-center mt-12">
          <a href="/courses" class="inline-flex items-center gap-2.5 bg-lime text-dark-blue font-button font-semibold text-sm px-8 py-4 rounded-full hover:scale-105 hover:bg-white transition-all duration-200">
            Explore Courses
          </a>
          <a href="/contact" class="inline-flex items-center gap-2.5 border border-white/30 text-white font-button font-semibold text-sm px-8 py-4 rounded-full hover:bg-white/10 transition-all duration-200">
            Get In Touch
          </a>
        </div>
      </div>
    </section>

  </main>
</Base>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function snapReveal(selector: string, staggerMs = 70) {
    if (reduced) return;
    const els = [...document.querySelectorAll<HTMLElement>(selector)];
    if (!els.length) return;
    els.forEach((el, i) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(28px)';
      el.style.transition = `opacity .55s ease ${i * staggerMs}ms, transform .55s ease ${i * staggerMs}ms`;
    });
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        el.style.opacity = '1';
        el.style.transform = 'none';
        io.unobserve(el);
      });
    }, { threshold: 0.05 });
    els.forEach(el => io.observe(el));
  }

  if (!reduced) {
    gsap.from('.about-hero .absolute.bottom-16 > div > *', {
      y: 32, opacity: 0, stagger: 0.1, duration: 0.8, ease: 'power3.out', delay: 0.2,
    });
  }

  snapReveal('.about-mission .grid > *', 120);
  snapReveal('.about-reasons .grid > *', 70);
</script>
