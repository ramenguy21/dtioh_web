<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function snapReveal(selector: string, staggerMs = 80) {
    if (reduced) return;
    const els = [...document.querySelectorAll<HTMLElement>(selector)];
    if (!els.length) return;
    els.forEach((el, i) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(24px)';
      el.style.transition = `opacity .55s ease ${i * staggerMs}ms, transform .55s ease ${i * staggerMs}ms`;
    });
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        el.style.opacity = '1';
        el.style.transform = 'none';
        io.unobserve(el);
      });
    }, { threshold: 0.05 });
    els.forEach(el => io.observe(el));
  }

  if (!reduced) {
    gsap.from('.course-listing-hero .absolute.bottom-14 > div > *', {
      y: 32, opacity: 0, stagger: 0.1, duration: 0.8, ease: 'power3.out', delay: 0.2,
    });
    gsap.from('.course-listing-cta .max-w-xl > *', {
      scrollTrigger: { trigger: '.course-listing-cta', start: 'top 65%' },
      y: 28, opacity: 0, stagger: 0.12, duration: 0.8, ease: 'power3.out',
    });
  }

  snapReveal('.course-listing-curriculum .grid > *', 90);
  snapReveal('.course-listing-curriculum ol li', 50);
  snapReveal('.course-listing-pricing .grid > *', 130);
</script>
