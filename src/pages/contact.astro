---
import Base from '../layouts/Base.astro';

const cities = [
  'Karachi',
  'Lahore',
  'Islamabad',
  'Rawalpindi',
  'Peshawar',
  'Quetta',
  'Multan',
  'Gujranwala',
  'Faisalabad',
  'Hyderabad',
  'Chakwal',
  'Sialkot',
];
---

<Base
  title="Contact | Dr. Tasneem's Institute of Health — Get In Touch"
  description="Contact Dr. Tasneem's Institute of Health in Karachi. DUHS-affiliated, SBTE-recognised aesthetic & healthcare training. Phone +92 302 2301918."
>
  <main>
    <section class="fold contact-fold relative">
      <!-- ── Background: soft green wash + lime glow ───────────── -->
      <div class="absolute inset-0 z-0 pointer-events-none" style="background: linear-gradient(170deg, #eef3ef 0%, #e6f0e6 42%, #dceada 100%)"></div>
      <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
        <div class="absolute -bottom-32 left-1/2 -translate-x-1/2 w-[760px] max-w-[120vw] h-[460px] rounded-full blur-3xl" style="background: rgba(192,241,128,0.55)"></div>
        <div class="absolute -top-24 -left-24 w-[420px] h-[420px] rounded-full blur-3xl" style="background: rgba(102,166,172,0.16)"></div>
      </div>

      <!-- ── Content ──────────────────────────────────────────── -->
      <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-16 py-28 lg:py-24">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

          <!-- LEFT — credibility copy -->
          <div class="contact-copy">
            <h2 class="font-heading font-bold leading-[1.08]" style="font-size: clamp(2.25rem, 4.5vw, 3.25rem);">
              <span class="text-dark-blue">Certify Yourself</span><br />
              <span class="text-teal">Through the experts</span>
            </h2>

            <p class="font-body text-dark-blue/70 text-sm lg:text-[0.95rem] leading-relaxed mt-6 max-w-xl">
              What sets us apart is our strong academic credibility. Every program
              is backed by internationally recognized certifications, with official
              affiliations to
              <strong class="text-teal font-semibold">Dow University of Health Sciences (DUHS)</strong>
              and the
              <strong class="text-teal font-semibold">Sindh Board of Technical Education (SBTE)</strong>.
              These partnerships ensure that your qualifications are not only
              respected in Pakistan but also carry weight internationally, giving
              you a competitive edge in the global market.
            </p>

            <p class="font-body font-semibold text-teal text-sm lg:text-[0.95rem] leading-relaxed mt-6 max-w-xl">
              By choosing Dr. Tasneem's Institute of Health, you're not just
              learning; you're earning a recognized qualification that opens doors
              worldwide.
            </p>
          </div>

          <!-- RIGHT — form -->
          <div class="contact-form-wrap">
            <p class="font-body text-dark-blue/75 text-sm text-left lg:text-right mb-5">
              Got something to say? Reach out to us now
            </p>

            <form
              id="contact-form"
              name="contact"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="grid sm:grid-cols-2 gap-4"
              novalidate
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="hidden">
                <label>Don't fill this out: <input name="bot-field" /></label>
              </p>
              <input type="hidden" name="city" id="city-value" />

              <!-- Full name -->
              <label class="sr-only" for="name">Full name</label>
              <input
                id="name" name="name" type="text" required autocomplete="name"
                placeholder="Full Name"
                class="field h-14 px-5 rounded-full"
              />

              <!-- City dropdown (custom) -->
              <div class="relative">
                <button
                  type="button"
                  id="city-toggle"
                  class="field w-full h-14 pl-5 pr-2 rounded-full flex items-center justify-between gap-3 text-left"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-label="Select city"
                >
                  <span id="city-label" class="text-dark-blue/45 font-body text-sm truncate">Select city</span>
                  <span class="w-10 h-10 shrink-0 rounded-full bg-teal grid place-items-center text-white">
                    <svg id="city-chevron" class="w-4 h-4 transition-transform duration-200" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 6l4 4 4-4" />
                    </svg>
                  </span>
                </button>

                <ul
                  id="city-list"
                  role="listbox"
                  aria-label="Cities"
                  tabindex="-1"
                  class="city-list absolute z-30 mt-2 left-0 right-0 max-h-60 overflow-y-auto rounded-2xl py-2 hidden"
                >
                  {cities.map((c) => (
                    <li
                      role="option"
                      aria-selected="false"
                      data-city={c}
                      class="city-option px-5 py-2 font-body text-sm text-dark-blue/75 cursor-pointer transition-colors"
                    >
                      {c}
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Query -->
              <label class="sr-only" for="query">Your query</label>
              <textarea
                id="query" name="message" required rows="5"
                placeholder="Enter your query"
                class="field sm:col-span-2 px-5 py-4 rounded-2xl resize-none"
              ></textarea>

              <!-- Email -->
              <div>
                <label class="sr-only" for="email">Email address</label>
                <input
                  id="email" name="email" type="email" required autocomplete="email"
                  placeholder="username@gmail.com"
                  aria-describedby="email-error"
                  class="field w-full h-14 px-5 rounded-full"
                />
                <p id="email-error" class="hidden mt-1.5 ml-4 text-xs font-body text-red-500">
                  please enter a valid email
                </p>
              </div>

              <!-- Contact number -->
              <div>
                <label class="sr-only" for="phone">Contact number</label>
                <input
                  id="phone" name="phone" type="tel" autocomplete="tel"
                  placeholder="Contact number"
                  class="field w-full h-14 px-5 rounded-full"
                />
              </div>

              <!-- Submit -->
              <button
                type="submit"
                id="contact-submit"
                disabled
                class="submit-btn sm:col-span-2 h-14 rounded-full font-button font-semibold text-sm inline-flex items-center justify-center gap-2 transition-all duration-200"
              >
                Submit form
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 13L13 3M6 3H13V10" />
                </svg>
              </button>
            </form>
          </div>

        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  /* The contact page is a single light fold; let it size to content on
     short/mobile screens instead of clipping the form. */
  .contact-fold { background: #eef3ef; }
  @media (max-width: 1023px) {
    .contact-fold {
      display: block;
      height: auto;
      overflow: visible;
      scroll-snap-align: none;
    }
  }

  /* Frosted-glass field shared style */
  .field {
    width: 100%;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.65);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 6px 18px rgba(12, 46, 60, 0.05);
    color: #0c2e3c;
    font-family: var(--font-body);
    font-size: 0.875rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .field::placeholder { color: rgba(12, 46, 60, 0.45); }
  .field:focus {
    outline: none;
    border-color: rgba(33, 145, 105, 0.65);
    box-shadow: 0 0 0 3px rgba(33, 145, 105, 0.15);
    background: rgba(255, 255, 255, 0.6);
  }
  .field.invalid {
    border-color: #ef4444;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12);
  }

  /* City dropdown panel */
  .city-list {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    box-shadow: 0 16px 40px rgba(12, 46, 60, 0.14);
  }
  .city-list::-webkit-scrollbar { width: 6px; }
  .city-list::-webkit-scrollbar-thumb { background: rgba(12, 46, 60, 0.18); border-radius: 9999px; }
  .city-option:hover,
  .city-option.active {
    color: #219169;
    background: rgba(33, 145, 105, 0.08);
  }
  .city-option[aria-selected='true'] { color: #219169; font-weight: 600; }

  /* Submit button — disabled vs enabled */
  .submit-btn {
    background: rgba(33, 145, 105, 0.45);
    color: rgba(255, 255, 255, 0.8);
    cursor: not-allowed;
  }
  .submit-btn:not(:disabled) {
    background: #219169;
    color: #ffffff;
    cursor: pointer;
  }
  .submit-btn:not(:disabled):hover { background: #1a7a58; transform: scale(1.01); }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>

<script>
  const form     = document.getElementById('contact-form') as HTMLFormElement | null;
  const toggle   = document.getElementById('city-toggle') as HTMLButtonElement | null;
  const list     = document.getElementById('city-list') as HTMLUListElement | null;
  const label    = document.getElementById('city-label') as HTMLElement | null;
  const chevron  = document.getElementById('city-chevron') as HTMLElement | null;
  const cityValue = document.getElementById('city-value') as HTMLInputElement | null;
  const name     = document.getElementById('name') as HTMLInputElement | null;
  const query    = document.getElementById('query') as HTMLTextAreaElement | null;
  const email    = document.getElementById('email') as HTMLInputElement | null;
  const emailErr = document.getElementById('email-error') as HTMLElement | null;
  const submit   = document.getElementById('contact-submit') as HTMLButtonElement | null;

  if (form && toggle && list && label && cityValue && name && query && email && submit) {
    const options = [...list.querySelectorAll<HTMLLIElement>('.city-option')];
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    let activeIndex = -1;

    // ── Dropdown open/close ──────────────────────────────────
    function openList() {
      list!.classList.remove('hidden');
      toggle!.setAttribute('aria-expanded', 'true');
      chevron?.classList.add('rotate-180');
    }
    function closeList() {
      list!.classList.add('hidden');
      toggle!.setAttribute('aria-expanded', 'false');
      chevron?.classList.remove('rotate-180');
    }
    function toggleList() {
      list!.classList.contains('hidden') ? openList() : closeList();
    }

    function selectCity(opt: HTMLLIElement) {
      options.forEach((o) => o.setAttribute('aria-selected', 'false'));
      opt.setAttribute('aria-selected', 'true');
      label!.textContent = opt.dataset.city!;
      label!.classList.remove('text-dark-blue/45');
      label!.classList.add('text-dark-blue');
      cityValue!.value = opt.dataset.city!;
      closeList();
      validate();
    }

    toggle.addEventListener('click', toggleList);
    options.forEach((opt, i) => {
      opt.addEventListener('click', () => selectCity(opt));
      opt.addEventListener('mouseenter', () => setActive(i));
    });

    function setActive(i: number) {
      options.forEach((o) => o.classList.remove('active'));
      activeIndex = i;
      if (i >= 0) {
        options[i].classList.add('active');
        options[i].scrollIntoView({ block: 'nearest' });
      }
    }

    // Keyboard support on the toggle
    toggle.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (list!.classList.contains('hidden')) openList();
        setActive(Math.min(activeIndex + 1, options.length - 1) || 0);
      }
    });
    list.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { closeList(); toggle!.focus(); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(Math.min(activeIndex + 1, options.length - 1)); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(Math.max(activeIndex - 1, 0)); }
      else if (e.key === 'Enter' && activeIndex >= 0) { e.preventDefault(); selectCity(options[activeIndex]); toggle!.focus(); }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!list!.contains(e.target as Node) && !toggle!.contains(e.target as Node)) closeList();
    });

    // ── Validation ───────────────────────────────────────────
    function checkEmail(showError: boolean) {
      const ok = emailRe.test(email!.value.trim());
      if (!ok && email!.value.trim() !== '' && showError) {
        email!.classList.add('invalid');
        emailErr?.classList.remove('hidden');
      } else {
        email!.classList.remove('invalid');
        emailErr?.classList.add('hidden');
      }
      return ok;
    }

    function validate() {
      const ok =
        name!.value.trim() !== '' &&
        cityValue!.value !== '' &&
        query!.value.trim() !== '' &&
        emailRe.test(email!.value.trim());
      submit!.disabled = !ok;
      return ok;
    }

    [name, query].forEach((el) => el.addEventListener('input', validate));
    email.addEventListener('input', () => { checkEmail(false); validate(); });
    email.addEventListener('blur', () => checkEmail(true));

    form.addEventListener('submit', (e) => {
      checkEmail(true);
      if (!validate()) { e.preventDefault(); return; }
      // Fire conversion events (guarded — no-op if analytics not loaded)
      (window as any).gtag?.('event', 'generate_lead', { event_category: 'contact_form', value: 1 });
      (window as any).fbq?.('track', 'Lead', { content_name: 'contact_form' });
    });
  }
</script>
