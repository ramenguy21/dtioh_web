---
import Base from '../layouts/Base.astro';
import {
  bookingSteps,
  buildWhatsAppUrl,
  clinicContact,
  clinicFaqs,
  clinicServices,
  clinicTrustIndicators,
  heroBookingMessage,
} from '../data/clinic';

const featuredServices = clinicServices.filter((service) =>
  ['laser', 'weight-management', 'hydrafacial', 'prp'].includes(service.key),
);
const featuredServiceKeys = new Set(featuredServices.map((service) => service.key));

const clinicSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: clinicFaqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];
---

<Base
  title="Clinic in Karachi | Dr. Tasneem's Clinic"
  description="Consultation-led aesthetic and wellness treatments in Malir Cantt, Karachi. Book PRP, laser hair removal, HydraFacial, weight management and more on WhatsApp."
  image="/images/services/hydra-facial.webp"
  ogType="website"
  schemaType="MedicalBusiness"
  extraSchemas={clinicSchemas}
>
  <main class="bg-cool-cream">
    <section class="relative overflow-hidden bg-dark-blue pt-32 pb-20 lg:pt-40 lg:pb-28" data-hero>
      <div class="absolute inset-0">
        <img
          src="/images/certified-bg.webp"
          alt=""
          class="h-full w-full object-cover opacity-35"
          loading="eager"
        />
        <div class="absolute inset-0 bg-[linear-gradient(135deg,rgba(12,46,60,0.94),rgba(12,46,60,0.72),rgba(33,145,105,0.45))]"></div>
      </div>
      <div class="relative mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1.15fr_0.85fr] lg:px-16">
        <div class="max-w-2xl">
          <p class="font-button text-sm font-semibold uppercase tracking-[0.3em] text-lime">
            Dr. Tasneem's Clinic · {clinicContact.locationLabel}
          </p>
          <h1 class="mt-5 font-heading text-4xl font-bold leading-tight text-white lg:text-6xl">
            Personalised <span class="text-lime">Aesthetic</span> &amp; Wellness Care in Karachi
          </h1>
          <p class="mt-5 max-w-xl font-body text-base leading-7 text-white/78 lg:text-lg">
            Consultation-led skin, hair, laser and wellness treatments delivered with clinical care at Dr. Tasneem's Clinic.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={buildWhatsAppUrl(heroBookingMessage, 'hero')}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-12 items-center justify-center rounded-full bg-teal px-8 py-4 font-button text-sm font-semibold text-white transition hover:bg-cta-hover hover:scale-[1.02]"
              aria-label="Book an appointment on WhatsApp"
              data-track-click
              data-event="hero_whatsapp_click"
              data-cta-location="hero"
              data-page="clinic"
            >
              Book on WhatsApp
            </a>
            <a
              href="#treatments"
              class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/24 px-8 py-4 font-button text-sm font-semibold text-white transition hover:bg-white/10"
              data-track-click
              data-event="booking_cta_click"
              data-cta-location="hero-secondary"
              data-page="clinic"
            >
              Explore Treatments
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-3">
            {clinicTrustIndicators.map((item) => (
              <span class="rounded-full border border-white/18 bg-white/8 px-4 py-2 font-button text-xs font-medium text-white/85 backdrop-blur">
                {item}
              </span>
            ))}
          </div>
        </div>

        <aside class="rounded-[2rem] border border-white/12 bg-white/10 p-6 text-white shadow-[0_18px_48px_rgba(0,0,0,0.18)] backdrop-blur md:p-8">
          <p class="font-button text-xs font-semibold uppercase tracking-[0.25em] text-lime">Quick booking</p>
          <h2 class="mt-4 font-heading text-2xl font-bold">Speak with the clinic team</h2>
          <p class="mt-3 font-body text-sm leading-6 text-white/78">
            Ask about timings, consultation fees, service availability, and preparation on WhatsApp.
          </p>
          <div class="mt-6 space-y-3">
            <a
              href={buildWhatsAppUrl(heroBookingMessage, 'hero-panel')}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-12 w-full items-center justify-center rounded-full bg-lime px-6 py-3 text-center font-button text-sm font-semibold text-dark-blue transition hover:bg-white"
              aria-label={`Book an appointment on WhatsApp using ${clinicContact.phoneDisplay}`}
              data-track-click
              data-event="booking_cta_click"
              data-cta-location="hero-panel"
              data-page="clinic"
            >
              Book on WhatsApp
            </a>
            <a
              href={`tel:${clinicContact.phoneE164}`}
              class="inline-flex min-h-12 w-full items-center justify-center rounded-full border border-white/25 px-6 py-3 text-center font-button text-sm font-semibold text-white transition hover:bg-white/10"
              aria-label={`Call Dr. Tasneem's Clinic at ${clinicContact.phoneDisplay}`}
              data-track-click
              data-event="phone_click"
              data-cta-location="hero-panel"
              data-page="clinic"
            >
              Call {clinicContact.phoneDisplay}
            </a>
          </div>
          <dl class="mt-6 space-y-4 border-t border-white/12 pt-6 font-body text-sm text-white/78">
            <div>
              <dt class="font-button text-xs font-semibold uppercase tracking-[0.22em] text-white/50">Location</dt>
              <dd class="mt-1">{clinicContact.addressLines.join(', ')}</dd>
            </div>
            <div>
              <dt class="font-button text-xs font-semibold uppercase tracking-[0.22em] text-white/50">Hours</dt>
              <dd class="mt-1">{clinicContact.hours[0]}</dd>
              <dd>{clinicContact.hours[1]}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="border-y border-dark-blue/8 bg-white/70 py-5">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-center gap-3 px-6 lg:px-16">
        {['Consultation-led care', 'WhatsApp booking', 'Priority services in Karachi', 'Telephone fallback available'].map((item) => (
          <span class="rounded-full bg-dark-blue/5 px-4 py-2 font-button text-xs font-semibold uppercase tracking-[0.18em] text-dark-blue/80">
            {item}
          </span>
        ))}
      </div>
    </section>

    <section id="treatments" class="relative overflow-hidden py-20 lg:py-24">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(192,241,128,0.24),transparent_35%),radial-gradient(circle_at_bottom_right,rgba(102,166,172,0.16),transparent_30%)]"></div>
      <div class="relative mx-auto max-w-7xl px-6 lg:px-16">
        <div class="max-w-2xl">
          <p class="font-button text-xs font-semibold uppercase tracking-[0.28em] text-teal">Priority treatments</p>
          <h2 class="mt-4 font-heading text-3xl font-bold text-dark-blue lg:text-5xl">
            Explore treatments with a <span class="text-teal">clear next step</span>
          </h2>
          <p class="mt-4 font-body text-base leading-7 text-dark-blue/70">
            Each service below includes what it is generally used for, what the consultation covers, and a direct WhatsApp action so your inquiry reaches the clinic with context.
          </p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
          {clinicServices.map((service) => (
            <article
              class="flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-dark-blue/8 bg-white shadow-[0_10px_36px_rgba(12,46,60,0.08)]"
              data-track-view
              data-event="treatment_viewed"
              data-service={service.key}
              data-page="clinic"
            >
              <div class="relative h-52 overflow-hidden" style={`background:${service.color}18`}>
                <img
                  src={service.image}
                  alt={service.title}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  width="640"
                  height="480"
                />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class="font-button text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-teal">
                  Suitable for
                </p>
                <p class="mt-1 font-body text-sm leading-6 text-dark-blue/70">{service.concern}</p>
                <h3 class="mt-4 font-heading text-2xl font-semibold text-dark-blue">{service.title}</h3>
                <p class="mt-3 font-body text-sm leading-6 text-dark-blue/68">{service.shortDescription}</p>
                {service.details.priceLabel && (
                  <p class="mt-4 rounded-2xl bg-lime/30 px-3 py-2 font-button text-xs font-semibold text-dark-blue">
                    {service.details.priceLabel.includes('Starting') ? service.details.priceLabel : `Price: ${service.details.priceLabel}`}
                  </p>
                )}
                <div class="mt-6 flex flex-col gap-3">
                  {featuredServiceKeys.has(service.key) && (
                    <a
                      href={`#service-${service.key}`}
                      class="inline-flex min-h-11 items-center justify-center rounded-full border border-dark-blue/12 px-4 py-3 font-button text-sm font-semibold text-dark-blue transition hover:border-teal hover:text-teal"
                      data-track-click
                      data-event="booking_cta_click"
                      data-cta-location="treatment-card-learn-more"
                      data-service={service.key}
                      data-page="clinic"
                    >
                      Learn More
                    </a>
                  )}
                  <a
                    href={buildWhatsAppUrl(service.whatsappMessage, 'treatment-card', service.key)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-11 items-center justify-center rounded-full bg-teal px-4 py-3 font-button text-sm font-semibold text-white transition hover:bg-cta-hover"
                    aria-label={`Book ${service.title} on WhatsApp`}
                    data-track-click
                    data-event="treatment_card_whatsapp_click"
                    data-cta-location="treatment-card"
                    data-service={service.key}
                    data-page="clinic"
                  >
                    Book on WhatsApp
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-dark-blue py-20 text-white lg:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-16">
        <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
          <div>
            <p class="font-button text-xs font-semibold uppercase tracking-[0.28em] text-lime">How booking works</p>
            <h2 class="mt-4 font-heading text-3xl font-bold lg:text-5xl">
              From first message to <span class="text-lime">consultation</span>
            </h2>
            <p class="mt-4 max-w-lg font-body text-base leading-7 text-white/74">
              Booking a consultation is simple, but treatment suitability is only confirmed after the clinic reviews your concern.
            </p>
          </div>
          <div class="grid gap-4 md:grid-cols-3">
            {bookingSteps.map((step, index) => (
              <article class="rounded-[1.5rem] border border-white/10 bg-white/8 p-6 backdrop-blur">
                <p class="font-button text-xs font-semibold uppercase tracking-[0.2em] text-lime">Step {index + 1}</p>
                <p class="mt-4 font-heading text-xl font-semibold">{step}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-16">
        <div class="grid gap-6 lg:grid-cols-[0.75fr_1.25fr]">
          <div class="rounded-[2rem] bg-dark-blue p-8 text-white">
            <p class="font-button text-xs font-semibold uppercase tracking-[0.28em] text-lime">Clinic credibility</p>
            <h2 class="mt-4 font-heading text-3xl font-bold">Care shaped by consultation, hygiene, and practitioner oversight</h2>
            <p class="mt-4 font-body text-base leading-7 text-white/76">
              The clinic page now focuses on verified operational details only: consultation-led treatment planning, certified practitioners, and the Malir Cantt location already referenced in the project.
            </p>
          </div>
          <div class="grid gap-6 md:grid-cols-2">
            {featuredServices.map((service) => (
              <article id={`service-${service.key}`} class="rounded-[2rem] border border-dark-blue/8 bg-white p-7 shadow-[0_10px_32px_rgba(12,46,60,0.06)]">
                <p class="font-button text-xs font-semibold uppercase tracking-[0.22em] text-teal">{service.title}</p>
                <p class="mt-4 font-body text-sm leading-6 text-dark-blue/72">{service.details.summary}</p>
                <div class="mt-5">
                  <h3 class="font-heading text-lg font-semibold text-dark-blue">Common reasons patients inquire</h3>
                  <ul class="mt-3 space-y-2 font-body text-sm leading-6 text-dark-blue/70">
                    {service.details.reasons.map((reason) => (
                      <li class="flex gap-2">
                        <span class="mt-2 h-1.5 w-1.5 rounded-full bg-teal"></span>
                        <span>{reason}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div class="mt-5 space-y-3 font-body text-sm leading-6 text-dark-blue/70">
                  <p><strong class="font-semibold text-dark-blue">Consultation:</strong> {service.details.consultation}</p>
                  <p><strong class="font-semibold text-dark-blue">Sessions:</strong> {service.details.sessions}</p>
                  <p><strong class="font-semibold text-dark-blue">Aftercare & downtime:</strong> {service.details.downtime}</p>
                  <p><strong class="font-semibold text-dark-blue">Suitability:</strong> {service.details.disclaimer}</p>
                </div>
                <a
                  href={buildWhatsAppUrl(service.whatsappMessage, 'service-detail', service.key)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-6 inline-flex min-h-11 items-center justify-center rounded-full bg-teal px-5 py-3 font-button text-sm font-semibold text-white transition hover:bg-cta-hover"
                  aria-label={`Ask about ${service.title} on WhatsApp`}
                  data-track-click
                  data-event="treatment_card_whatsapp_click"
                  data-cta-location="service-detail"
                  data-service={service.key}
                  data-page="clinic"
                >
                  Ask about {service.title}
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="border-y border-dark-blue/8 bg-white py-20 lg:py-24">
      <div class="mx-auto max-w-5xl px-6 lg:px-16">
        <div class="max-w-2xl">
          <p class="font-button text-xs font-semibold uppercase tracking-[0.28em] text-teal">Frequently asked questions</p>
          <h2 class="mt-4 font-heading text-3xl font-bold text-dark-blue lg:text-5xl">
            Questions patients often ask <span class="text-teal">before booking</span>
          </h2>
        </div>
        <div class="mt-10 space-y-4">
          {clinicFaqs.map((faq, index) => (
            <details class="group rounded-[1.5rem] border border-dark-blue/10 bg-cool-cream/80 p-5" data-track-faq data-faq-index={index + 1} data-page="clinic">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-semibold text-dark-blue">
                <span>{faq.question}</span>
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-teal transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 max-w-3xl font-body text-sm leading-6 text-dark-blue/72">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-16">
        <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
          <article class="rounded-[2rem] bg-dark-blue p-8 text-white">
            <p class="font-button text-xs font-semibold uppercase tracking-[0.28em] text-lime">Location & contact</p>
            <h2 class="mt-4 font-heading text-3xl font-bold">Visit the clinic in Malir Cantt, Karachi</h2>
            <p class="mt-4 font-body text-base leading-7 text-white/76">
              The repository contains verified clinic contact details for Malir Cantt and the canonical phone number below. A public map URL was not present, so this section avoids inventing one.
            </p>
            <dl class="mt-8 space-y-5 font-body text-sm text-white/82">
              <div>
                <dt class="font-button text-xs font-semibold uppercase tracking-[0.22em] text-white/50">Phone</dt>
                <dd class="mt-1">{clinicContact.phoneDisplay}</dd>
              </div>
              <div>
                <dt class="font-button text-xs font-semibold uppercase tracking-[0.22em] text-white/50">Email</dt>
                <dd class="mt-1">{clinicContact.email}</dd>
              </div>
              <div>
                <dt class="font-button text-xs font-semibold uppercase tracking-[0.22em] text-white/50">Address</dt>
                <dd class="mt-1">{clinicContact.addressLines[0]}</dd>
                <dd>{clinicContact.addressLines[1]}</dd>
              </div>
              <div>
                <dt class="font-button text-xs font-semibold uppercase tracking-[0.22em] text-white/50">Appointments</dt>
                <dd class="mt-1">WhatsApp to confirm timings before visiting.</dd>
              </div>
            </dl>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href={buildWhatsAppUrl(heroBookingMessage, 'location')}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center justify-center rounded-full bg-lime px-6 py-3 font-button text-sm font-semibold text-dark-blue transition hover:bg-white"
                aria-label="Book on WhatsApp from the contact section"
                data-track-click
                data-event="hero_whatsapp_click"
                data-cta-location="location"
                data-page="clinic"
              >
                Book on WhatsApp
              </a>
              <a
                href={`tel:${clinicContact.phoneE164}`}
                class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/20 px-6 py-3 font-button text-sm font-semibold text-white transition hover:bg-white/10"
                aria-label={`Call ${clinicContact.phoneDisplay}`}
                data-track-click
                data-event="phone_click"
                data-cta-location="location"
                data-page="clinic"
              >
                Call the clinic
              </a>
            </div>
          </article>

          <article class="rounded-[2rem] border border-dark-blue/8 bg-[linear-gradient(160deg,#ebf6ee,#f7fbf8)] p-8">
            <p class="font-button text-xs font-semibold uppercase tracking-[0.28em] text-teal">Final booking CTA</p>
            <h2 class="mt-4 font-heading text-3xl font-bold text-dark-blue">Ready to ask about timings or a treatment?</h2>
            <p class="mt-4 max-w-xl font-body text-base leading-7 text-dark-blue/72">
              Message the clinic on WhatsApp for appointment availability, pricing questions, and consultation guidance. If you prefer, call the clinic directly using the same canonical number.
            </p>
            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a
                href={buildWhatsAppUrl(heroBookingMessage, 'final-cta')}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-12 items-center justify-center rounded-full bg-teal px-6 py-3 font-button text-sm font-semibold text-white transition hover:bg-cta-hover"
                aria-label="Open WhatsApp to book an appointment"
                data-track-click
                data-event="hero_whatsapp_click"
                data-cta-location="final-cta"
                data-page="clinic"
              >
                Book on WhatsApp
              </a>
              <a
                href={`tel:${clinicContact.phoneE164}`}
                class="inline-flex min-h-12 items-center justify-center rounded-full border border-dark-blue/14 px-6 py-3 font-button text-sm font-semibold text-dark-blue transition hover:border-teal hover:text-teal"
                aria-label={`Call Dr. Tasneem's Clinic at ${clinicContact.phoneDisplay}`}
                data-track-click
                data-event="phone_click"
                data-cta-location="final-cta"
                data-page="clinic"
              >
                Call {clinicContact.phoneDisplay}
              </a>
            </div>
            <div class="mt-8 rounded-[1.5rem] border border-dark-blue/8 bg-white p-5">
              <p class="font-button text-xs font-semibold uppercase tracking-[0.2em] text-dark-blue/52">Booking note</p>
              <p class="mt-3 font-body text-sm leading-6 text-dark-blue/68">
                Booking a consultation does not guarantee a treatment until the clinic confirms suitability, timing, and any preparation needed.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <a
      href={buildWhatsAppUrl(heroBookingMessage, 'mobile-sticky')}
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-whatsapp-cta fixed inset-x-4 bottom-4 z-40 inline-flex min-h-14 items-center justify-center rounded-full bg-teal px-6 py-4 font-button text-sm font-semibold text-white shadow-[0_14px_30px_rgba(12,46,60,0.24)] lg:hidden"
      aria-label="Book an appointment on WhatsApp"
      data-track-click
      data-event="hero_whatsapp_click"
      data-cta-location="mobile-sticky"
      data-page="clinic"
    >
      Book on WhatsApp
    </a>
  </main>
</Base>

<style>
  .mobile-whatsapp-cta {
    padding-bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-whatsapp-cta,
    [data-track-view] {
      transition: none;
      animation: none;
    }
  }
  </style>

<script>
  import { getCampaignParams, trackEvent } from '../utils/tracking';

  const campaignParams = getCampaignParams(new URLSearchParams(window.location.search));

  document.querySelectorAll<HTMLElement>('[data-track-click]').forEach((element) => {
    element.addEventListener('click', () => {
      trackEvent(element.dataset.event ?? 'booking_cta_click', {
        page: element.dataset.page ?? 'clinic',
        service: element.dataset.service,
        cta_location: element.dataset.ctaLocation,
        ...campaignParams,
      });
    });
  });

  document.querySelectorAll<HTMLDetailsElement>('[data-track-faq]').forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (!detail.open) return;
      trackEvent('faq_interaction', {
        page: detail.dataset.page ?? 'clinic',
        faq_index: detail.dataset.faqIndex,
        ...campaignParams,
      });
    });
  });

  const viewedServices = new Set<string>();
  const serviceObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const element = entry.target as HTMLElement;
        const service = element.dataset.service;
        if (!service || viewedServices.has(service)) return;
        viewedServices.add(service);
        trackEvent(element.dataset.event ?? 'treatment_viewed', {
          page: element.dataset.page ?? 'clinic',
          service,
          ...campaignParams,
        });
      });
    },
    { threshold: 0.45 },
  );

  document.querySelectorAll<HTMLElement>('[data-track-view]').forEach((element) => {
    serviceObserver.observe(element);
  });
</script>
